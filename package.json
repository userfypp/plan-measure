{
  "name": "plan-measure",
  "private": true,
  "version": "2.11.3",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf:size": "node perf/size.mjs",
    "perf:size:diff": "node perf/size-diff.mjs",
    "perf:e2e": "node perf/run.mjs",
    "perf:e2e:strict": "node perf/run.mjs --strict",
    "perf:update-baseline": "node perf/run.mjs --update-baseline",
    "perf:selftest": "node --test perf/budgets.check.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "konva": "10.9.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-konva": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
